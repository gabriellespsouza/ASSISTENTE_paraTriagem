@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white text-center p-4 rounded-top-4">

                    <i class="bi bi-person-circle"
                       style="font-size:60px"></i>

                    <h2 class="mt-3">
                        Entrar
                    </h2>

                    <p class="mb-0">
                        Assistente Inteligente para Triagem 
                    </p>

                </div>


                <div class="card-body p-4">


                    <form method="post">


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger">
                        </div>


                        <div class="form-floating mb-3">

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   placeholder="Email" />

                            <label asp-for="Input.Email">
                                Email
                            </label>

                            <span asp-validation-for="Input.Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="form-floating mb-3">

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   placeholder="Senha" />

                            <label asp-for="Input.Password">
                                Senha
                            </label>

                            <span asp-validation-for="Input.Password"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="form-check mb-4">

                            <input asp-for="Input.RememberMe"
                                   class="form-check-input" />

                            <label asp-for="Input.RememberMe"
                                   class="form-check-label">

                                Lembrar-me

                            </label>

                        </div>


                        <button type="submit"
                                class="btn btn-primary w-100 btn-lg rounded-pill">

                            <i class="bi bi-box-arrow-in-right"></i>

                            Entrar

                        </button>


                    </form>


                    <div class="text-center mt-4">

                        <a asp-page="./Register">
                            Criar uma conta
                        </a>

                    </div>


                </div>

            </div>

        </div>

    </div>

</div>