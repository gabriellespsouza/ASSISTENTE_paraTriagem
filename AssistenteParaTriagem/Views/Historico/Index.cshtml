@model IEnumerable<AssistenteParaTriagem.Models.AvaliacaoTriagem>

@{
    ViewData["Title"] = "Histórico de Triagens";
}

<div class="container py-5">

    <h1 class="text-primary fw-bold mb-4">
        Histórico de Triagens
    </h1>

    <div class="card border-0 shadow">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>
                            <th>Data</th>
                            <th>Profissional</th>
                            <th>Queixa</th>
                            <th>Classificação</th>
                            <th>Tempo</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.DataHora.ToString(
                                        "dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @item.NomeProfissional
                                </td>

                                <td>
                                    @item.Queixa
                                </td>

                                <td>
                                    <strong>
                                        @item.CorRisco
                                    </strong>
                                </td>

                                <td>
                                    @item.TempoMaximo min
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>