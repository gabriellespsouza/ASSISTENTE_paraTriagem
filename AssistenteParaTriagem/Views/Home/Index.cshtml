@{
    ViewData["Title"] =
        "Assistente Inteligente para Triagem";
}

<style>

    .hero-shell {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 55%, #083d8f 100%);
        padding: 4px;
        box-shadow: 0 20px 45px rgba(13, 110, 253, .25);
    }

    .hero-inner {
        border-radius: 26px;
        padding: 56px 48px;
        position: relative;
        overflow: hidden;
    }

        .hero-inner::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            top: -180px;
            right: -140px;
        }

        .hero-inner::after {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
            bottom: -140px;
            left: -100px;
        }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.16);
        color: #fff;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: .05em;
        padding: 8px 16px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.25);
    }

    .hero-title {
        color: #fff;
        font-weight: 800;
        font-size: 2.6rem;
        line-height: 1.15;
        margin-top: 22px;
    }

    .hero-lead {
        color: rgba(255,255,255,.9);
        font-size: 1.1rem;
        margin-top: 18px;
        max-width: 560px;
    }

    .hero-alert {
        margin-top: 26px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.3);
        border-radius: 16px;
        padding: 16px 20px;
        color: #fff;
        backdrop-filter: blur(2px);
    }

    .hero-cta {
        margin-top: 30px;
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
    }

    .btn-hero-primary {
        background: #fff;
        color: #0a58ca;
        font-weight: 700;
        border-radius: 14px;
        padding: 14px 26px;
        border: none;
        transition: .25s;
    }

        .btn-hero-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,.2);
            color: #0a58ca;
        }

    .btn-hero-outline {
        background: transparent;
        color: #fff;
        font-weight: 700;
        border-radius: 14px;
        padding: 14px 26px;
        border: 2px solid rgba(255,255,255,.6);
        transition: .25s;
    }

        .btn-hero-outline:hover {
            background: rgba(255,255,255,.14);
            color: #fff;
            transform: translateY(-2px);
        }

    .arch-card {
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 18px 40px rgba(13,38,76,.12);
        padding: 40px 34px;
        height: 100%;
    }

    .arch-title {
        color: #0a58ca;
        font-weight: 800;
        font-size: 1.3rem;
    }

    .arch-step {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px 16px;
        border-radius: 14px;
        transition: .2s;
        margin-bottom: 6px;
    }

        .arch-step:hover {
            background: #eef4ff;
            transform: translateX(4px);
        }

    .arch-icon {
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        color: #fff;
    }

    .arch-step span.step-text {
        font-weight: 600;
        color: #22324a;
    }

    .stats-row {
        margin-top: 56px;
    }

    .stat-card {
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 10px 26px rgba(13,38,76,.08);
        padding: 26px;
        text-align: center;
        height: 100%;
        border-top: 4px solid #0d6efd;
        transition: .2s;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 32px rgba(13,38,76,.14);
        }

    .stat-number {
        font-size: 1.9rem;
        font-weight: 800;
        color: #0a58ca;
    }

    .stat-label {
        color: #5c6b82;
        font-weight: 600;
        font-size: .92rem;
    }
</style>

<div class="container py-4">

    <div class="hero-shell">

        <div class="hero-inner">

            <div class="row align-items-center g-5">

                <div class="col-lg-7">

                    <span class="hero-badge">
                        <i class="bi bi-mortarboard-fill"></i>
                        PROTÓTIPO DE PESQUISA
                    </span>

                    <h1 class="hero-title">
                        Assistente Inteligente
                        para Triagem
                    </h1>

                    <p class="hero-lead">
                        Sistema de apoio à decisão para classificação
                        de risco em pronto atendimento, utilizando
                        Processamento de Linguagem Natural e um
                        motor de regras clínicas baseado em
                        discriminadores de urgência.
                    </p>

                    <div class="hero-alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Importante:</strong>
                        O sistema é um protótipo de apoio à decisão.
                        Não realiza diagnóstico médico e não substitui
                        a avaliação do profissional de saúde.
                    </div>

                    <div class="hero-cta">

                        <a asp-controller="Triagem"
                           asp-action="Index"
                           class="btn btn-hero-primary btn-lg">

                            <i class="bi bi-heart-pulse-fill me-2"></i>
                            Iniciar Triagem

                        </a>

                        <a asp-controller="Avaliacao"
                           asp-action="Index"
                           class="btn btn-hero-outline btn-lg">

                            <i class="bi bi-clipboard-data-fill me-2"></i>
                            Avaliar Protótipo

                        </a>

                    </div>

                </div>

                <div class="col-lg-5">

                    <div class="arch-card">

                        <div class="arch-title">
                            <i class="bi bi-diagram-3-fill me-2"></i>
                            Arquitetura
                        </div>

                        <hr class="mt-3 mb-3" />

                        <div class="arch-step">
                            <div class="arch-icon"><i class="bi bi-chat-left-text-fill"></i></div>
                            <span class="step-text">Queixa e sintomas</span>
                        </div>

                        <div class="arch-step">
                            <div class="arch-icon"><i class="bi bi-cpu-fill"></i></div>
                            <span class="step-text">Processamento de Linguagem Natural</span>
                        </div>

                        <div class="arch-step">
                            <div class="arch-icon"><i class="bi bi-clipboard2-pulse-fill"></i></div>
                            <span class="step-text">Discriminadores clínicos</span>
                        </div>

                        <div class="arch-step">
                            <div class="arch-icon"><i class="bi bi-gear-fill"></i></div>
                            <span class="step-text">Motor de regras</span>
                        </div>

                        <div class="arch-step">
                            <div class="arch-icon"><i class="bi bi-signpost-split-fill"></i></div>
                            <span class="step-text">Classificação de risco</span>
                        </div>

                        <div class="arch-step">
                            <div class="arch-icon"><i class="bi bi-search"></i></div>
                            <span class="step-text">Justificativa explicável</span>
                        </div>

                        <div class="arch-step">
                            <div class="arch-icon"><i class="bi bi-journal-check"></i></div>
                            <span class="step-text">Registro de auditoria</span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

  

</div>
