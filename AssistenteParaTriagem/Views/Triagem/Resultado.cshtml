@model AssistenteParaTriagem.Models.ResultadoTriagem

@{
    ViewData["Title"] = "Resultado da Triagem";

    string classeCor = Model.Cor switch
    {
        AssistenteParaTriagem.Models.CorTriagem.Vermelho => "bg-danger",
        AssistenteParaTriagem.Models.CorTriagem.Laranja => "bg-orange",
        AssistenteParaTriagem.Models.CorTriagem.Amarelo => "bg-warning text-dark",
        AssistenteParaTriagem.Models.CorTriagem.Verde => "bg-success",
        AssistenteParaTriagem.Models.CorTriagem.Azul => "bg-primary",
        _ => "bg-secondary"
    };

    string descricao = Model.Cor switch
    {
        AssistenteParaTriagem.Models.CorTriagem.Vermelho => "Emergência",
        AssistenteParaTriagem.Models.CorTriagem.Laranja => "Muito Urgente",
        AssistenteParaTriagem.Models.CorTriagem.Amarelo => "Urgente",
        AssistenteParaTriagem.Models.CorTriagem.Verde => "Pouco Urgente",
        AssistenteParaTriagem.Models.CorTriagem.Azul => "Não Urgente",
        _ => ""
    };

    string icone = Model.Cor switch
    {
        AssistenteParaTriagem.Models.CorTriagem.Vermelho => "bi-heart-pulse-fill",
        AssistenteParaTriagem.Models.CorTriagem.Laranja => "bi-exclamation-triangle-fill",
        AssistenteParaTriagem.Models.CorTriagem.Amarelo => "bi-exclamation-circle-fill",
        AssistenteParaTriagem.Models.CorTriagem.Verde => "bi-check-circle-fill",
        AssistenteParaTriagem.Models.CorTriagem.Azul => "bi-info-circle-fill",
        _ => "bi-clipboard2-pulse-fill"
    };
}

<style>

    body {
        background: #eef3f8;
    }

    /* =========================
           CARD PRINCIPAL
           ========================= */

    .resultado-card {
        border: none;
        border-radius: 26px;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(13,38,76,.12);
        animation: fade .5s ease;
    }

    @@keyframes fade {

        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================
           CABEÇALHO
           ========================= */

    .header-cor {
        padding: 42px 44px;
        position: relative;
        overflow: hidden;
        text-align: center;
        color: white;
    }

        /* Círculo decorativo superior */

        .header-cor::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            top: -140px;
            right: -80px;
        }

        /* Círculo decorativo inferior */

        .header-cor::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            bottom: -100px;
            left: -50px;
        }

        /* Elementos do cabeçalho ficam acima dos círculos */

        .header-cor > * {
            position: relative;
            z-index: 2;
        }


    /* =========================
           ÍCONE DO CABEÇALHO
           ========================= */

    .icone {
        width: 72px;
        height: 72px;
        border-radius: 18px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        margin: 0 auto 16px;
    }


    /* =========================
           TÍTULO
           ========================= */

    .header-cor h2 {
        font-weight: 800;
        margin-bottom: 8px;
    }


    /* =========================
           COR DA CLASSIFICAÇÃO
           ========================= */

    .resultado-cor {
        font-size: 52px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-top: 18px;
        margin-bottom: 10px;
    }


    /* =========================
           CORES MANCHESTER
           ========================= */

    .bg-danger {
        background: linear-gradient( 135deg, #dc3545 0%, #a71d2a 100% ) !important;
    }

    .bg-orange {
        background: linear-gradient( 135deg, #fd7e14 0%, #dc6502 100% ) !important;
        color: white;
    }

    .bg-warning {
        background: linear-gradient( 135deg, #ffc107 0%, #d39e00 100% ) !important;
    }

    .bg-success {
        background: linear-gradient( 135deg, #198754 0%, #126b40 100% ) !important;
    }

    .bg-primary {
        background: linear-gradient( 135deg, #0d6efd 0%, #0a58ca 100% ) !important;
    }

    .bg-secondary {
        background: linear-gradient( 135deg, #6c757d 0%, #495057 100% ) !important;
    }


    /* =========================
           BADGE DA DESCRIÇÃO
           ========================= */

    .badge-status {
        display: inline-block;
        background: rgba(255,255,255,.95) !important;
        color: #212529 !important;
        font-size: 17px;
        font-weight: 700;
        padding: 10px 28px;
        border-radius: 30px;
        box-shadow: 0 5px 15px rgba(0,0,0,.12);
    }


    /* =========================
           BOXES DO CONTEÚDO
           ========================= */

    .box {
        background: white;
        border: none;
        border-radius: 18px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 5px 18px rgba(0,0,0,.08);
    }


    /* =========================
           TÍTULOS DAS SEÇÕES
           ========================= */

    .titulo {
        font-size: 22px;
        font-weight: 700;
        color: #0d6efd;
        margin-bottom: 20px;
    }


    /* =========================
           TEMPO
           ========================= */

    .tempo {
        font-size: 42px;
        font-weight: bold;
    }


    /* =========================
           DISCRIMINADORES
           ========================= */

    .discriminador-card {
        border: 1px solid #eef1f6;
        border-radius: 16px;
        background: #fbfcfe;
        transition: .2s;
    }

        .discriminador-card:hover {
            border-color: #cfe0ff;
            box-shadow: 0 8px 20px rgba(13,38,76,.08);
            transform: translateY(-2px);
        }


    /* =========================
           REGRAS CLÍNICAS
           ========================= */

    .list-group-item {
        border: none;
        border-left: 5px solid #0d6efd;
        background: #f8f9fc;
        margin-bottom: 12px;
        border-radius: 12px;
        padding: 15px;
    }


    /* =========================
           BOTÕES
           ========================= */

    .btn {
        border-radius: 16px;
        padding: 12px 35px;
        font-weight: 600;
        transition: .3s;
    }

        .btn:hover {
            transform: translateY(-2px);
        }


    /* =========================
           ALERTA
           ========================= */

    .resultado-alert {
        border-radius: 16px;
        background: #fff8e6;
        border: 1px solid #ffe4a3;
        padding: 18px 22px;
        display: flex;
        gap: 14px;
        align-items: flex-start;
    }

        .resultado-alert i {
            font-size: 22px;
            color: #b8860b;
            margin-top: 2px;
        }


    /* =========================
           RESPONSIVO
           ========================= */

    @@media (max-width: 768px) {

        .header-cor {
            padding: 35px 20px;
        }

        .resultado-cor {
            font-size: 40px;
        }

        .icone {
            width: 64px;
            height: 64px;
            font-size: 30px;
        }

        .card-body {
            padding: 25px !important;
        }

        .btn {
            width: 100%;
            margin-bottom: 10px;
        }
    }


    /* =========================
           IMPRESSÃO
           ========================= */

    @@media print {

        body {
            background: white;
        }

        .btn {
            display: none;
        }

        .resultado-card {
            box-shadow: none;
        }

        .header-cor {
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }
    }

</style>


<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card resultado-card">


                <!-- =========================
                     CABEÇALHO
                     ========================= -->

                <div class="header-cor @classeCor">

                    <i class="bi @icone icone"></i>

                    <h2>
                        Resultado da Triagem 
                    </h2>

                    <p> Classificação sugerida pelo sistema de apoio à decisão </p>

                    <div class="resultado-cor">
                        @Model.Cor.ToString().ToUpper()
                    </div>

                    <span class="badge-status">
                        @descricao
                    </span>

                </div>


                <!-- =========================
                     CONTEÚDO
                     ========================= -->

                <div class="card-body p-5">


                    <!-- JUSTIFICATIVA CLÍNICA -->

                    <div class="box">

                        <div class="titulo">

                            <i class="bi bi-file-medical-fill"></i>

                            Justificativa Clínica

                        </div>

                        <p class="lead mb-0">

                            @Model.Justificativa

                        </p>

                    </div>


                    <!-- TEMPO MÁXIMO -->

                    <div class="box text-center">

                        <div class="titulo">

                            <i class="bi bi-stopwatch-fill"></i>

                            Tempo Máximo para Atendimento

                        </div>

                        <div class="tempo text-primary">

                            @Model.TempoMaximo

                            <small class="fs-5">
                                minutos
                            </small>

                        </div>

                    </div>


                    <!-- DISCRIMINADORES -->
                    @if (Model.Discriminadores?.Any() == true)
                    {
                        <div class="box">

                            <div class="titulo">

                                <i class="bi bi-list-check"></i>

                                Discriminadores Identificados

                            </div>

                            <div class="row">

                                @foreach (var item in Model.Discriminadores)
                                {
                                    <div class="col-md-6 mb-3">

                                        <div class="card shadow-sm border-0 h-100 discriminador-card">

                                            <div class="card-body">

                                                <h5 class="text-primary">

                                                    <i class="bi bi-check-circle-fill"></i>

                                                    @item.Nome

                                                </h5>

                                                <p class="text-muted mb-0">

                                                    @item.Justificativa

                                                </p>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    }


                    <!-- REGRAS CLÍNICAS -->
                    @if (Model.RegrasAplicadas?.Any() == true)
                    {
                        <div class="box">

                            <div class="titulo">

                                <i class="bi bi-shield-check"></i>

                                Regras Clínicas Aplicadas

                            </div>

                            <ul class="list-group">

                                @foreach (var regra in Model.RegrasAplicadas)
                                {
                                    <li class="list-group-item">

                                        <i class="bi bi-check-circle-fill text-success me-2"></i>

                                        @regra

                                    </li>
                                }

                            </ul>

                        </div>
                    }


                    <!-- AVISO -->

                    <div class="alert alert-warning mt-4">

                        <strong>⚠ Apoio à decisão:</strong>

                        @Model.Aviso

                    </div>


                    <!-- BOTÕES -->

                    <div class="text-center mt-5">

                        <a asp-action="Index"
                           class="btn btn-primary btn-lg me-3">

                            <i class="bi bi-arrow-clockwise"></i>

                            Nova Triagem

                        </a>

                       

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

