@{
    ViewData["Title"] = "Nova Triagem";
}

<style>

    .tri-shell {
        max-width: 880px;
        margin: 0 auto;
    }

    .tri-header {
        border-radius: 26px 26px 0 0;
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 60%, #083d8f 100%);
        padding: 42px 44px;
        position: relative;
        overflow: hidden;
        color: #fff;
    }

        .tri-header::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            top: -120px;
            right: -80px;
        }

    .tri-header-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 14px;
    }

    .tri-header h2 {
        font-weight: 800;
        margin-bottom: 4px;
    }

    .tri-header p {
        opacity: .9;
        margin-bottom: 0;
    }

    .tri-card {
        border-radius: 0 0 26px 26px;
        background: #fff;
        box-shadow: 0 18px 45px rgba(13,38,76,.12);
        padding: 46px;
    }

    .tri-section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 800;
        font-size: 1.15rem;
        margin-bottom: 22px;
    }

        .tri-section-title .icon-chip {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 17px;
        }

        .tri-section-title.paciente .icon-chip {
            background: linear-gradient(135deg, #0d6efd, #0a58ca);
        }

        .tri-section-title.vitais .icon-chip {
            background: linear-gradient(135deg, #dc3545, #a71d2a);
        }

    .tri-section {
        margin-bottom: 40px;
    }

    .form-control-lg, .form-control {
        border-radius: 12px;
        border: 1px solid #dfe6f0;
        padding: 12px 16px;
    }

        .form-control:focus, .form-control-lg:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.12);
        }

    .vital-card {
        border: 1px solid #eef1f6;
        border-radius: 16px;
        padding: 16px 18px;
        height: 100%;
        transition: .2s;
        background: #fbfcfe;
    }

        .vital-card:hover {
            border-color: #cfe0ff;
            box-shadow: 0 8px 20px rgba(13,38,76,.08);
        }

    .vital-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        color: #22324a;
        margin-bottom: 10px;
        font-size: .92rem;
    }

        .vital-label .vi {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 14px;
            flex-shrink: 0;
        }

    .vi-fc {
        background: #dc3545;
    }

    .vi-fr {
        background: #0dcaf0;
    }

    .vi-pas {
        background: #6f42c1;
    }

    .vi-spo2 {
        background: #198754;
    }

    .vi-temp {
        background: #fd7e14;
    }

    .inconsciente-card {
        border: 1px dashed #f1b0b7;
        border-radius: 16px;
        background: #fff5f5;
        padding: 16px 18px;
        height: 100%;
        display: flex;
        align-items: center;
    }

    .tri-alert {
        border-radius: 16px;
        background: #fff8e6;
        border: 1px solid #ffe4a3;
        padding: 18px 22px;
        display: flex;
        gap: 14px;
        align-items: flex-start;
    }

        .tri-alert i {
            font-size: 22px;
            color: #b8860b;
            margin-top: 2px;
        }

    .btn-classificar {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        border: none;
        border-radius: 16px;
        padding: 16px 46px;
        font-weight: 700;
        font-size: 1.05rem;
        box-shadow: 0 12px 26px rgba(13,110,253,.3);
        transition: .25s;
    }

        .btn-classificar:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 32px rgba(13,110,253,.4);
        }
</style>

<div class="container py-5">

    <div class="tri-shell">

        <div class="tri-header">

            <div class="tri-header-icon">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>

            <h2>Assistente Inteligente para Triagem</h2>

            <p>Preencha os dados abaixo para obter uma sugestão de classificação de risco</p>

        </div>

        <div class="tri-card">

            <form asp-action="Avaliar" method="post">

                <!-- DADOS DO PACIENTE -->

                <div class="tri-section">

                    <div class="tri-section-title paciente">
                        <span class="icon-chip"><i class="bi bi-person-fill"></i></span>
                        Dados do Paciente
                    </div>

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            Queixa Principal
                        </label>

                        <textarea class="form-control form-control-lg"
                                  name="queixa"
                                  rows="3"
                                  required
                                  placeholder="Ex.: Dor intensa no peito"></textarea>

                    </div>

                    <div>

                        <label class="form-label fw-semibold">
                            Sinais e Sintomas
                        </label>

                        <textarea class="form-control form-control-lg"
                                  name="sintomas"
                                  rows="4"
                                  placeholder="Ex.: Falta de ar, febre, vômito, cefaleia"></textarea>

                    </div>

                </div>

                <!-- SINAIS VITAIS -->

                <div class="tri-section">

                    <div class="tri-section-title vitais">
                        <span class="icon-chip"><i class="bi bi-activity"></i></span>
                        Sinais Vitais
                    </div>

                    <div class="row g-3">

                        <div class="col-md-4">

                            <div class="vital-card">

                                <div class="vital-label">
                                    <span class="vi vi-fc"><i class="bi bi-heart-fill"></i></span>
                                    Frequência Cardíaca
                                </div>

                                <div class="input-group">

                                    <input type="number"
                                           class="form-control"
                                           name="fc"
                                           min="0"
                                           max="300">

                                    <span class="input-group-text">bpm</span>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="vital-card">

                                <div class="vital-label">
                                    <span class="vi vi-fr"><i class="bi bi-lungs-fill"></i></span>
                                    Frequência Respiratória
                                </div>

                                <div class="input-group">

                                    <input type="number"
                                           class="form-control"
                                           name="fr"
                                           min="0"
                                           max="100">

                                    <span class="input-group-text">irpm</span>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="vital-card">

                                <div class="vital-label">
                                    <span class="vi vi-pas"><i class="bi bi-droplet-fill"></i></span>
                                    Pressão Sistólica
                                </div>

                                <div class="input-group">

                                    <input type="number"
                                           class="form-control"
                                           name="pas"
                                           min="0"
                                           max="300">

                                    <span class="input-group-text">mmHg</span>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="vital-card">

                                <div class="vital-label">
                                    <span class="vi vi-spo2"><i class="bi bi-moisture"></i></span>
                                    Saturação O₂
                                </div>

                                <div class="input-group">

                                    <input type="number"
                                           class="form-control"
                                           name="spo2"
                                           min="0"
                                           max="100">

                                    <span class="input-group-text">%</span>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="vital-card">

                                <div class="vital-label">
                                    <span class="vi vi-temp"><i class="bi bi-thermometer-half"></i></span>
                                    Temperatura
                                </div>

                                <div class="input-group">

                                    <input type="text"
                                           class="form-control"
                                           name="temperatura"
                                           placeholder="36,5">

                                    <span class="input-group-text">°C</span>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="inconsciente-card">

                                <div class="form-check form-switch fs-5 mb-0">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="pacienteInconsciente"
                                           value="true"
                                           id="inconsciente">

                                    <label class="form-check-label fw-bold"
                                           for="inconsciente">

                                        Paciente inconsciente

                                    </label>

                                </div>

                            </div>

                        </div>

                    </div>

                  

                </div>

                <div class="tri-alert mb-5">

                    <i class="bi bi-exclamation-triangle-fill"></i>

                    <div>
                        <strong>Importante:</strong>
                        Este sistema fornece uma sugestão de classificação
                        de risco para apoio à decisão. Ele não realiza
                        diagnóstico médico e não substitui a avaliação,
                        julgamento e responsabilidade do profissional de saúde.
                    </div>

                </div>

                <div class="text-center">

                    <button type="submit"
                            class="btn btn-primary btn-classificar text-white">

                        <i class="bi bi-search me-2"></i>
                        Classificar Risco

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
