@{
    ViewData["Title"] = "Triagem Manchester";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">

                    <h2 class="fw-bold mb-1">
                        🏥 Assistente Inteligente para Triagem
                    </h2>

                    <p class="mb-0">
                        Protocolo de Manchester
                    </p>

                </div>

                <div class="card-body p-5">

                    <form asp-action="Avaliar" method="post">

                        <!-- DADOS DO PACIENTE -->

                        <div class="mb-4">

                            <h4 class="text-primary fw-bold border-bottom pb-2">
                                👤 Dados do Paciente
                            </h4>

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Queixa Principal
                            </label>

                            <textarea class="form-control form-control-lg"
                                      name="queixa"
                                      rows="3"
                                      required
                                      placeholder="Ex.: Dor intensa no peito"></textarea>

                        </div>

                        <div class="mb-5">

                            <label class="form-label fw-semibold">
                                Sinais e Sintomas
                            </label>

                            <textarea class="form-control form-control-lg"
                                      name="sintomas"
                                      rows="4"
                                      placeholder="Ex.: Falta de ar, febre, vômito, cefaleia"></textarea>

                        </div>

                        <!-- SINAIS VITAIS -->

                        <div class="mb-4">

                            <h4 class="text-danger fw-bold border-bottom pb-2">
                                ❤️ Sinais Vitais
                            </h4>

                        </div>

                        <div class="row g-4">

                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    ❤️ Frequência Cardíaca
                                </label>

                                <div class="input-group">

                                    <input type="number"
                                           class="form-control"
                                           name="fc"
                                           min="0"
                                           max="300">

                                    <span class="input-group-text">
                                        bpm
                                    </span>

                                </div>

                            </div>

                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    🫁 Frequência Respiratória
                                </label>

                                <div class="input-group">

                                    <input type="number"
                                           class="form-control"
                                           name="fr"
                                           min="0"
                                           max="100">

                                    <span class="input-group-text">
                                        irpm
                                    </span>

                                </div>

                            </div>

                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    🩸 Pressão Sistólica
                                </label>

                                <div class="input-group">

                                    <input type="number"
                                           class="form-control"
                                           name="pas"
                                           min="0"
                                           max="300">

                                    <span class="input-group-text">
                                        mmHg
                                    </span>

                                </div>

                            </div>

                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    🫧 Saturação O₂
                                </label>

                                <div class="input-group">

                                    <input type="number"
                                           class="form-control"
                                           name="spo2"
                                           min="0"
                                           max="100">

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>

                            </div>

                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    🌡 Temperatura
                                </label>

                                <div class="input-group">

                                    <input type="text"
                                           class="form-control"
                                           name="temperatura"
                                           placeholder="36,5">

                                    <span class="input-group-text">
                                        °C
                                    </span>

                                </div>

                            </div>

                            <div class="col-md-4 d-flex align-items-end">

                                <div class="form-check form-switch fs-5">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="pacienteInconsciente"
                                           value="true"
                                           id="inconsciente">

                                    <label class="form-check-label fw-bold"
                                           for="inconsciente">

                                        Paciente inconsciente

                                    </label>

                                </div>

                            </div>

                        </div>

                        <div class="alert alert-info mt-5">

                            <strong>ℹ Atenção:</strong>

                            Informe os sinais vitais sempre que disponíveis.
                            Quanto mais informações forem fornecidas, mais
                            precisa será a classificação de risco.

                        </div>

                        <div class="text-center mt-5">

                            <button type="submit"
                                    class="btn btn-primary btn-lg px-5 py-3 shadow">

                                🔍 Classificar Risco

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>